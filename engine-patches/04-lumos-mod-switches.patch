diff --git a/crates/horizon-core/src/lumos_mods.rs b/crates/horizon-core/src/lumos_mods.rs
new file mode 100644
index 0000000..011b504
--- /dev/null
+++ b/crates/horizon-core/src/lumos_mods.rs
@@ -0,0 +1,145 @@
+//! Lumos Client: which of the native mods built into this game may run.
+//!
+//! Lumos's all-in-one game has every native mod compiled in, and the player's instance turns on
+//! only the ones they installed (`mod.<id>:true` in `horizon-mods.txt`; every other built-in mod
+//! is `mod.<id>:false`). Lumos's build (tools/lumos_native/gate.py) starts every hook of every
+//! mod with [`lumos_mod_on!`], so a mod turned off does nothing at all, whether or not its own
+//! code asks `native_on`.
+//!
+//! The switches are process-wide (the window's game and the integrated server share them), set
+//! by the settings (`ModList`) whenever they are read or changed. Until then they are read once
+//! from `horizon-mods.txt` in the game folder (the working directory), so hooks that run before
+//! the settings (allocator, registries) follow them too.
+//!
+//! Hidden mods are the ones off when the game started: the instance doesn't have them, so the
+//! game shows them nowhere (Options > Mods, Key Binds, mod lists). A mod the player turns off
+//! during the session stays listed, so it can be turned on again.
+
+use std::collections::BTreeSet;
+use std::sync::RwLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+struct Switches {
+    disabled: BTreeSet<String>,
+    hidden: Option<BTreeSet<String>>,
+}
+
+static SWITCHES: RwLock<Option<Switches>> = RwLock::new(None);
+/// Bumped at each change, so that each hook's cached answer ([`cached`]) is asked again. Starts
+/// at 1: a cache of 0 has never been filled.
+static GENERATION: AtomicU64 = AtomicU64::new(1);
+
+/// `mod.<id>:false` lines of a `horizon-mods.txt`.
+pub fn parse_disabled(text: &str) -> BTreeSet<String> {
+    text.lines()
+        .filter_map(|l| l.split_once(':'))
+        .filter(|(_, v)| v.trim() == "false")
+        .filter_map(|(k, _)| k.trim().strip_prefix("mod."))
+        .map(str::to_owned)
+        .collect()
+}
+
+fn from_game_dir() -> BTreeSet<String> {
+    let dir = std::env::current_dir().unwrap_or_default();
+    std::fs::read_to_string(dir.join("horizon-mods.txt"))
+        .map(|t| parse_disabled(&t))
+        .unwrap_or_default()
+}
+
+fn with<R>(f: impl FnOnce(&Switches) -> R) -> R {
+    {
+        let read = SWITCHES.read().unwrap_or_else(|e| e.into_inner());
+        if let Some(s) = read.as_ref() {
+            return f(s);
+        }
+    }
+    let mut write = SWITCHES.write().unwrap_or_else(|e| e.into_inner());
+    if write.is_none() {
+        *write = Some(Switches {
+            disabled: from_game_dir(),
+            hidden: None,
+        });
+        GENERATION.fetch_add(1, Ordering::AcqRel);
+    }
+    f(write.as_ref().expect("set above"))
+}
+
+/// The mods turned off now (`ModList::disabled`). The first call also fixes the hidden mods:
+/// those off when the game started.
+pub fn publish(disabled: &BTreeSet<String>) {
+    let mut write = SWITCHES.write().unwrap_or_else(|e| e.into_inner());
+    match write.as_mut() {
+        Some(s) => {
+            if s.hidden.is_none() {
+                s.hidden = Some(disabled.clone());
+            }
+            if s.disabled != *disabled {
+                s.disabled = disabled.clone();
+                GENERATION.fetch_add(1, Ordering::AcqRel);
+            }
+        }
+        None => {
+            *write = Some(Switches {
+                disabled: disabled.clone(),
+                hidden: Some(disabled.clone()),
+            });
+            GENERATION.fetch_add(1, Ordering::AcqRel);
+        }
+    }
+}
+
+/// Mod `id` may run now.
+pub fn on(id: &str) -> bool {
+    with(|s| !s.disabled.contains(id))
+}
+
+/// Mod `id` is the instance's (on when the game started, or turned on since): the game may list
+/// it. A hidden mod turned on during the session shows again.
+pub fn shown(id: &str) -> bool {
+    with(|s| {
+        !s.disabled.contains(id) || !s.hidden.as_ref().is_some_and(|h| h.contains(id))
+    })
+}
+
+/// [`on`] or [`shown`] (`listing`), remembered in `cache` until the switches change: a hook's
+/// check is two atomic loads.
+#[doc(hidden)]
+pub fn cached(cache: &AtomicU64, id: &str, listing: bool) -> bool {
+    let generation = GENERATION.load(Ordering::Acquire);
+    let c = cache.load(Ordering::Relaxed);
+    if c >> 1 == generation {
+        return c & 1 == 1;
+    }
+    let answer = if listing { shown(id) } else { on(id) };
+    cache.store(generation << 1 | u64::from(answer), Ordering::Relaxed);
+    answer
+}
+
+/// Whether native mod `$id` may run: the first statement of each of its hooks in Lumos's builds.
+#[macro_export]
+macro_rules! lumos_mod_on {
+    ($id:literal) => {{
+        static LUMOS_GATE: ::core::sync::atomic::AtomicU64 = ::core::sync::atomic::AtomicU64::new(0);
+        $crate::lumos_mods::cached(&LUMOS_GATE, $id, false)
+    }};
+}
+
+/// Whether native mod `$id` may list itself (Options > Mods, its settings page).
+#[macro_export]
+macro_rules! lumos_mod_shown {
+    ($id:literal) => {{
+        static LUMOS_GATE: ::core::sync::atomic::AtomicU64 = ::core::sync::atomic::AtomicU64::new(0);
+        $crate::lumos_mods::cached(&LUMOS_GATE, $id, true)
+    }};
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_the_off_lines() {
+        let off = parse_disabled("mod.gyro:false\nmod.zoom:true\nkey.zoom.use:key.keyboard.c\n mod.veinminer : false\n");
+        assert_eq!(off, ["gyro", "veinminer"].map(String::from).into());
+    }
+}
