+/// How long `native_setting` trusts a value it read from disk.
+const SETTING_FRESH: Duration = Duration::from_secs(1);
+/// Mods' settings by file: when each was read and what it held (None: no
+/// file). One for the whole process, so the window and its server thread see
+/// each other's `native_set_setting`.
+type SettingCache = Mutex<HashMap<PathBuf, (Instant, Option<String>)>>;
+fn setting_cache() -> &'static SettingCache {
+    static CACHE: OnceLock<SettingCache> = OnceLock::new();
+    CACHE.get_or_init(Default::default)
+}
+/// The setting in `path` as `read` gives it, read again only when the kept one
+/// is `SETTING_FRESH` old or older.
+fn cached_setting(
+    cache: &SettingCache,
+    path: PathBuf,
+    now: Instant,
+    read: impl FnOnce(&Path) -> Option<String>,
+) -> Option<String> {
+    if let Some((at, value)) = cache.lock().unwrap_or_else(|e| e.into_inner()).get(&path)
+        && now.saturating_duration_since(*at) < SETTING_FRESH
+    {
+        return value.clone();
+    }
+    let value = read(&path);
+    cache
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .insert(path, (now, value.clone()));
+    value
+}
+/// After `native_set_setting` wrote `value` to `path`: keep it as read now, or,
+/// when the write failed, forget the file so the next read goes to disk.
+fn remember_setting(cache: &SettingCache, path: PathBuf, now: Instant, written: bool, value: &str) {
+    let mut cache = cache.lock().unwrap_or_else(|e| e.into_inner());
+    if written {
+        cache.insert(path, (now, Some(value.trim().to_owned())));
+    } else {
+        cache.remove(&path);
+    }
+}
 
