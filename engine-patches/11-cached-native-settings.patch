+#[test]
+fn native_settings_are_kept_a_second_and_set_at_once() {
+    use super::{SETTING_FRESH, SettingCache, cached_setting, remember_setting};
+    use std::time::{Duration, Instant};
+    let dir = std::env::temp_dir().join(format!("horizon-setting-cache-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("zoom");
+    let disk = |p: &std::path::Path| std::fs::read_to_string(p).ok().map(|v| v.trim().to_owned());
+    let cache = SettingCache::default();
+    let t0 = Instant::now();
+    // No file: None, as before, and kept.
+    assert_eq!(cached_setting(&cache, path.clone(), t0, disk), None);
+    std::fs::write(&path, " 2 \n").unwrap();
+    assert_eq!(cached_setting(&cache, path.clone(), t0 + Duration::from_millis(500), disk), None);
+    // A change outside the game shows once the kept value is a second old.
+    assert_eq!(cached_setting(&cache, path.clone(), t0 + SETTING_FRESH, disk).as_deref(), Some("2"));
+    std::fs::write(&path, "3").unwrap();
+    let t1 = t0 + SETTING_FRESH + Duration::from_millis(10);
+    assert_eq!(cached_setting(&cache, path.clone(), t1, disk).as_deref(), Some("2"));
+    // Not read from disk while fresh.
+    let t2 = t0 + SETTING_FRESH + Duration::from_millis(20);
+    assert_eq!(cached_setting(&cache, path.clone(), t2, |_| unreachable!()).as_deref(), Some("2"));
+    // native_set_setting's write is seen at once, trimmed as a read would be.
+    std::fs::write(&path, " 4\n").unwrap();
+    remember_setting(&cache, path.clone(), t2, true, " 4\n");
+    assert_eq!(cached_setting(&cache, path.clone(), t2, |_| unreachable!()).as_deref(), Some("4"));
+    // A failed write forgets the value: the next read goes to disk.
+    std::fs::write(&path, "5").unwrap();
+    remember_setting(&cache, path.clone(), t2, false, "6");
+    assert_eq!(cached_setting(&cache, path.clone(), t2, disk).as_deref(), Some("5"));
+    let _ = std::fs::remove_dir_all(&dir);
+}
